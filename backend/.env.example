# =============================================================================
# SoftNeos Presupuestos - plantilla de entorno
# Copia este fichero a .env y ejecuta `php artisan key:generate`.
# .env NO se versiona (contiene secretos); este fichero sí.
# =============================================================================

# --- Aplicación ---------------------------------------------------------------
APP_NAME="SoftNeos Presupuestos"
APP_ENV=local
# Clave de cifrado de sesiones y cookies. La genera `php artisan key:generate`.
APP_KEY=
APP_DEBUG=true
# URL del backend Laravel (php artisan serve).
APP_URL=http://localhost:8000

# Idioma de la interfaz y de los datos falsos de las factories.
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# --- SPA Angular y autenticación (Sanctum en modo SPA, cookie de sesión) -----
# Adónde se redirige tras el login de Blade.
#   Modo desarrollo: http://localhost:4200 (ng serve)
#   Modo demo:       http://localhost:8000/app (build servido por Laravel)
FRONTEND_URL=http://localhost:4200
# Orígenes (host:puerto) cuyas peticiones a /api se autentican con la cookie de
# sesión en lugar de con tokens. Si el origen no está aquí, /api responde 401.
SANCTUM_STATEFUL_DOMAINS=localhost:4200,localhost:8000

# --- Logs ---------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de datos ------------------------------------------------------------
# SQLite: un fichero en database/database.sqlite, sin servidor.
# Para MySQL: DB_CONNECTION=mysql y descomenta las 5 variables de abajo.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# --- Sesión -------------------------------------------------------------------
# Sesiones guardadas en la tabla `sessions`.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Dominio de la cookie de sesión. Las cookies no distinguen puertos, así que
# la misma cookie vale para :8000 (Blade) y :4200 (Angular vía proxy).
SESSION_DOMAIN=localhost

# --- Colas, caché y otros servicios (no se usan en esta prueba) ---------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Los emails se escriben en storage/logs/laravel.log en vez de enviarse.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
